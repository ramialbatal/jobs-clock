{
  "name": "jobs-clock",
  "version": "1.0.0",
  "private": true,
  "description": "Live clock of net new jobs vs people looking for work, for the world and major economies.",
  "type": "module",
  "license": "MIT",
  "author": "Rami Albatal",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramialbatal/jobs-clock.git"
  },
  "homepage": "https://ramialbatal.github.io/jobs-clock/",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "style": "node scripts/check-style.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run style && npm run typecheck && npm test",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "clock-core": "github:ramialbatal/clock-core#a797dbe276a74ade23168464fe1fe51b6a48fba6",
    "playwright": "1.48.2",
    "typescript": "5.6.3"
  },
  "smoke": {
    "ticking": [
      "#w-jobs",
      "#g-jobs"
    ],
    "verdicts": [
      "#goal-verdict",
      "#sdg-verdict"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
